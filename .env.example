# Üniversite ve İdari Ofis Ajan Şirketi Yapılandırması (.env)

# Telegram Bot Yapılandırması
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail İletişim (Postacı - Uygulama Şifresi)
